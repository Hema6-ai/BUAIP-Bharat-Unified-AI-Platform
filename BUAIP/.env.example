# Core AWS credentials and runtime
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace_with_access_key
AWS_SECRET_ACCESS_KEY=replace_with_secret_key
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# External APIs
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER=your_openweathermap_api_key_here

# Core tables
DYNAMODB_CONVERSATIONS_TABLE=buaip-conversations
DYNAMODB_FACTS_VECTOR_TABLE=buaip-facts-vector
DYNAMODB_TRANSLATION_CACHE_TABLE=buaip-translation-cache
DYNAMODB_TABLE_NAME=BUAIP_Queries

# Search and knowledge
KENDRA_INDEX_ID=
AWS_KENDRA_INDEX_ID=

# Storage and CDN
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET=
AWS_S3_DATA_PREFIX=data/
AWS_S3_UPLOADS_PREFIX=uploads/
CLOUDFRONT_DOMAIN=
TRANSCRIBE_OUTPUT_BUCKET=

# GlobalSeller feature integrations
GLOBALSELLER_CACHE_TABLE=
GLOBALSELLER_DATA_BUCKET=
GLOBALSELLER_METADATA_TABLE=
GLOBALSELLER_SNS_TOPIC_ARN=
RDS_CLUSTER_ARN=
RDS_SECRET_ARN=
RDS_DATABASE=

# Location and personalization (optional)
AWS_LOCATION_INDEX_NAME=place-index
AWS_LOCATION_MAP_NAME=map
PERSONALIZE_CAMPAIGN_ARN=
PERSONALIZE_DATASET_GROUP_ARN=

# Notifications and workflows (optional)
SNS_NOTIFICATIONS_TOPIC=
SNS_ALERTS_TOPIC=
SNS_ANALYTICS_TOPIC=
SES_FROM_EMAIL=noreply@example.com
SES_FROM_NAME=BU-AIP Platform
STEP_FUNCTION_NLP_PIPELINE=
STEP_FUNCTION_DATA_PROCESSING=
LAMBDA_PREPROCESSING_FUNCTION=
LAMBDA_POSTPROCESSING_FUNCTION=
LAMBDA_NLP_ANALYSIS_FUNCTION=
EVENT_BUS_NAME=default

# Monitoring
CLOUDWATCH_NAMESPACE=BU-AIP/Platform
CLOUDWATCH_LOG_GROUP=/aws/bu-aip
ENABLE_DETAILED_METRICS=false
ERROR_RATE_THRESHOLD=0.05
RESPONSE_TIME_THRESHOLD=5000

# Service toggles
ENABLE_BEDROCK=true
ENABLE_POLLY=true
ENABLE_TRANSLATE=true
ENABLE_TRANSCRIBE=true
ENABLE_COMPREHEND=true
ENABLE_REKOGNITION=true
ENABLE_TEXTRACT=true
ENABLE_LOCATION=true
ENABLE_DYNAMODB=true
ENABLE_S3=true
ENABLE_SNS=true
ENABLE_SES=true
ENABLE_KENDRA=true
ENABLE_PERSONALIZE=true
ENABLE_EVENTBRIDGE=true
ENABLE_LAMBDA=true
ENABLE_STEP_FUNCTIONS=true
ENABLE_CLOUDWATCH=true

# Scheduler and external APIs
ENABLE_SIGNAL_SCHEDULER=false
POLLY_DEFAULT_VOICE=Aditi
POLLY_ENGINE=neural
TRANSCRIBE_LANGUAGE=en-IN
ELASTICSEARCH_DOMAIN=
ELASTICSEARCH_INDEX=schemes

# Optional DynamoDB tables for broader AWS setup
DYNAMODB_USERS_TABLE=bu-aip-users
DYNAMODB_SESSIONS_TABLE=bu-aip-sessions
DYNAMODB_INTERACTIONS_TABLE=bu-aip-interactions
DYNAMODB_ANALYTICS_TABLE=bu-aip-analytics
