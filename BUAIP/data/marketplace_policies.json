{
  "platforms": {
    "amazon_in": {
      "platform_name": "Amazon.in",
      "policy_categories": [
        {
          "category": "Account Health",
          "critical_metrics": {
            "order_defect_rate": {
              "threshold": "< 1%",
              "components": ["Negative feedback", "A-to-Z claims", "Chargebacks"],
              "violation_severity": "HIGH",
              "consequence": "Account suspension if > 1% for 60 days",
              "remedy": "Appeal within 17 hours of suspension. Provide POA (Plan of Action)."
            },
            "late_dispatch_rate": {
              "threshold": "< 4%",
              "violation_severity": "MEDIUM",
              "consequence": "Featured merchant status loss. Search ranking penalty.",
              "remedy": "Enable Seller Fulfilled Prime (SFP) or use FBA."
            },
            "cancellation_rate": {
              "threshold": "< 2.5%",
              "violation_severity": "HIGH",
              "consequence": "Account deactivation if > 2.5% consistently.",
              "remedy": "Stock management + automated inventory sync."
            },
            "valid_tracking_rate": {
              "threshold": "> 95%",
              "violation_severity": "MEDIUM",
              "consequence": "Shipping setting restrictions. Buy Shipping penalty.",
              "remedy": "Use Amazon-integrated carriers (Bluedart, Delhivery)."
            }
          }
        },
        {
          "category": "Product Compliance",
          "violations": [
            {
              "violation": "Inauthentic Product",
              "triggers": ["Customer complaint", "Brand gating", "Test buy failure"],
              "severity": "CRITICAL",
              "consequence": "Immediate listing removal + possible account suspension",
              "remedy": "Provide invoices, authorization letters, supply chain proof within 24 hours.",
              "prevention": "Source from authorized distributors. Keep invoices 365 days."
            },
            {
              "violation": "Restricted Product",
              "triggers": ["Pesticides without license", "Medical devices without approval", "Alcohol"],
              "severity": "CRITICAL",
              "consequence": "Account termination + legal liability",
              "remedy": "No remedy. Do not list restricted items.",
              "prevention": "Check Amazon Restricted Products page before listing."
            },
            {
              "violation": "Product Safety",
              "triggers": ["BIS certification missing", "Safety recalls", "Customer injury"],
              "severity": "HIGH",
              "consequence": "Listing blocked + legal notice + INR hold",
              "remedy": "Provide BIS/ISI certificate + safety test reports.",
              "prevention": "Never skip certification for electronics, toys, food."
            },
            {
              "violation": "Intellectual Property",
              "triggers": ["Brand complaint", "Copyright notice", "Patent claim"],
              "severity": "HIGH",
              "consequence": "ASIN removal + account suspension after 3 strikes",
              "remedy": "Retract appeal if genuine. Provide authorization if licensed.",
              "prevention": "Do not use brand names/logos without permission."
            }
          ]
        },
        {
          "category": "Listing Quality",
          "violations": [
            {
              "violation": "Inaccurate Product Information",
              "triggers": ["Customer complaints", "A-to-Z claims", "Returns for wrong item"],
              "severity": "MEDIUM",
              "consequence": "Listing suppression. Search ranking drop.",
              "remedy": "Update listing accurately. Contact support to reinstate.",
              "prevention": "Use correct title, image, description, attributes."
            },
            {
              "violation": "Prohibited Content",
              "triggers": ["External links", "Contact info", "Promotional language"],
              "severity": "MEDIUM",
              "consequence": "Listing removed. Repeat = account warning.",
              "remedy": "Edit listing to remove violations.",
              "prevention": "No emails, phones, URLs, competitor mentions in listing."
            }
          ]
        },
        {
          "category": "Pricing & Promotions",
          "violations": [
            {
              "violation": "Price Gouging",
              "triggers": ["Price 50%+ higher than recent avg", "Emergency/disaster pricing"],
              "severity": "HIGH",
              "consequence": "Listing blocked. Account review. Negative PR risk.",
              "remedy": "Adjust price to market rate. Explain cost increase.",
              "prevention": "Do not spike prices during crises (COVID, floods, etc)."
            },
            {
              "violation": "Misuse of Promotions",
              "triggers": ["Fake discount (no real MRP)", "Coupon abuse", "Referral gaming"],
              "severity": "MEDIUM",
              "consequence": "Promotion revoked. Account flagged.",
              "remedy": "Follow MRP laws. Genuine discounts only.",
              "prevention": "MRP must be printed on package. Do not inflate MRP."
            }
          ]
        }
      ],
      "appeals_process": {
        "response_time": "17 hours for critical violations",
        "poa_structure": [
          "1. Root cause (why it happened)",
          "2. Immediate actions taken (what you did)",
          "3. Long-term prevention (how you'll prevent future)"
        ],
        "poa_tips": [
          "Be specific. No generic templates.",
          "Attach proof (invoices, screenshots, SOPs).",
          "Show systemic changes, not one-time fixes.",
          "Admit fault. Do not blame Amazon or customers."
        ],
        "rejection_rate": "60-70% of first appeals rejected",
        "success_strategy": "Resubmit with more proof and detail. Escalate to jeff@amazon.com (Bezos escalation route) for unjust cases."
      },
      "policy_resources": [
        "https://sellercentral.amazon.in/gp/help/1801",
        "https://sellercentral.amazon.in/gp/help/G200164330",
        "https://sellercentral.amazon.in/gp/help/G200500120"
      ]
    },
