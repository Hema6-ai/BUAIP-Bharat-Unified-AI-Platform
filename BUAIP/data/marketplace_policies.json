              "prevention": "Call customer before dispatch for confirmation."
            }
          ]
        },
        {
          "category": "Pricing & Discounts",
          "violations": [
            {
              "violation": "Unrealistic Pricing",
              "triggers": ["₹1 pricing", "₹0.01 listings", "Price < cost"],
              "severity": "MEDIUM",
              "consequence": "Listing flagged. Account review.",
              "remedy": "Correct pricing to realistic value.",
              "prevention": "Do not game system with ultra-low pricing."
            },
            {
              "violation": "Discount Misrepresentation",
              "triggers": ["Fake MRP sticker", "Inflated original price"],
              "severity": "HIGH",
              "consequence": "Listing removal. Legal notice (Consumer Protection Act).",
              "remedy": "Use genuine MRP. Follow legal metrology rules.",
              "prevention": "MRP must match product package. No sticker manipulation."
            }
          ]
        }
      ],
      "appeals_process": {
        "response_time": "48-72 hours",
        "appeal_format": "Submit via Seller Panel > Support > Appeal",
        "success_tips": [
          "Attach proof of authorization",
          "Show corrective actions",
          "Provide supplier invoices",
          "Demonstrate quality control measures"
